{
  "id": "example-overlay-sweep-001",
  "namespace": "vllm",
  "source": {"repo": "https://github.com/your-org/llm-d.git", "ref": "your-branch"},
  "vllm_image": "quay.io/your-org/vllm:your-nightly-tag",
  "build_repo": "https://github.com/your-org/vllm.git",
  "builds": [
    {"name": "branch2", "steps": [
      {"ref": "branch0", "action": "checkout"},
      {"ref": "branch1", "action": "merge"},
      {"ref": "branch2", "action": "cherry-pick"}
    ], "deepep": {"repo": "https://github.com/your-org/DeepEP.git", "ref": "your-deepep-branch"}},
    {"name": "branch3", "steps": [
      {"ref": "branch0", "action": "checkout"},
      {"ref": "branch1", "action": "merge"},
      {"ref": "branch3", "action": "cherry-pick"}
    ], "deepep": {"repo": "https://github.com/your-org/DeepEP.git", "ref": "your-deepep-branch"}}
  ],
  "results_pvc": "agentx-results",
  "benchmark_queue": "live-benchmark-client",
  "campaign_queue": "benchmark-campaign",
  "rollout_timeout_seconds": 3600,
  "admission_timeout_seconds": 3600,
  "cleanup_timeout_seconds": 600,
  "continue_on_failure": false,
  "overlays": [
    {
      "name": "pd-1p2d2-mtp-off-offload-off",
      "path": "overlays/pd-1p2d2-mtp-off-offload-off",
      "model_label": "your-model",
      "pod_selector": "llm-d.ai/model=your-model,llm-d.ai/inference-serving=true",
      "expected_pods": 4,
      "dimensions": {"topology": "pd", "pd_size": "1p2d2", "mtp": "off", "offloading": "off"}
    },
    {
      "name": "pd-1p2d2-mtp-on-offload-on",
      "path": "overlays/pd-1p2d2-mtp-on-offload-on",
      "model_label": "your-model",
      "pod_selector": "llm-d.ai/model=your-model,llm-d.ai/inference-serving=true",
      "expected_pods": 4,
      "dimensions": {"topology": "pd", "pd_size": "1p2d2", "mtp": "on", "offloading": "on"}
    },
    {
      "name": "aggregate-mtp-off",
      "path": "overlays/aggregate-mtp-off",
      "model_label": "your-model",
      "pod_selector": "llm-d.ai/model=your-model,llm-d.ai/inference-serving=true",
      "expected_pods": 2,
      "dimensions": {"topology": "aggregate", "mtp": "off", "offloading": "off"}
    }
  ],
  "benchmarks": [
    {"tool": "aiperf", "concurrencies": [1, 4, 8, 16], "duration_seconds": 900},
    {"tool": "nyann", "concurrencies": [1, 4, 8], "duration_seconds": 900, "isl": 1024, "osl": 512, "warmup_seconds": 60}
  ]
}
