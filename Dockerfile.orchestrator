FROM alpine:3.20

ARG MANIFESTO_REPO=https://github.com/tlrmchlsmth/llm-manifesto.git
ARG MANIFESTO_REF=main
ARG CAMPAIGN_OVERLAY_REPO=""
ARG CAMPAIGN_OVERLAY_REF=""

RUN apk add --no-cache \
    bash coreutils findutils grep tar curl git \
    python3 \
    gettext openssl

# kubectl
RUN curl -LO "https://dl.k8s.io/release/$(curl -sL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
    && install kubectl /usr/local/bin/ && rm kubectl

# helm
RUN curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

# just
RUN curl -fsSL https://just.systems/install.sh | bash -s -- --to /usr/local/bin

# uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/

# Python venv with networking niceties
RUN uv venv /opt/venv \
    && VIRTUAL_ENV=/opt/venv uv pip install requests httpx pyyaml rich

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /workspace

COPY . /workspace/agentx-mvp

RUN git clone --depth 1 "${MANIFESTO_REPO}" /workspace/llm-manifesto \
    && git -C /workspace/llm-manifesto fetch --depth 1 origin "${MANIFESTO_REF}" \
    && git -C /workspace/llm-manifesto checkout FETCH_HEAD \
    && if [ -n "${CAMPAIGN_OVERLAY_REPO}" ]; then \
         test -n "${CAMPAIGN_OVERLAY_REF}" && \
         git clone --depth 1 "${CAMPAIGN_OVERLAY_REPO}" /workspace/overlays && \
         git -C /workspace/overlays fetch --depth 1 origin "${CAMPAIGN_OVERLAY_REF}" && \
         git -C /workspace/overlays checkout FETCH_HEAD && \
         rm -rf /workspace/overlays/.git; \
       fi \
    && rm -rf \
      /workspace/agentx-mvp/.git \
      /workspace/agentx-mvp/.venv \
      /workspace/agentx-mvp/.pytest_cache \
      /workspace/agentx-mvp/__pycache__ \
      /workspace/llm-manifesto/.git \
      /workspace/llm-manifesto/.venv \
      /workspace/llm-manifesto/.pytest_cache \
      /workspace/llm-manifesto/__pycache__

CMD ["sleep", "infinity"]
